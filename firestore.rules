rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles: any authenticated user can read, only self can write
    match /users/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Presence: any authenticated user can read; each user writes only their own doc
    match /presence/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Invitations
    match /invitations/{invId} {
      // Only the sender or recipient may read
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);

      // Only the sender may create, and it must start as 'pending'
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status  == 'pending';

      // Recipient may accept or decline; sender may cancel (set to 'declined')
      allow update: if request.auth != null
        && (resource.data.toUid   == request.auth.uid
            || resource.data.fromUid == request.auth.uid)
        && request.resource.data.status in ['accepted', 'declined'];
    }

    // Games
    match /games/{gameId} {
      allow read: if request.auth != null;

      // Chat messages sub-collection
      match /messages/{msgId} {
        allow read: if request.auth != null;

        // Human message: sender must identify as themselves
        // Bot message: any game participant may write the bot reply
        allow create: if request.auth != null && (
          (request.resource.data.isBot == false
            && request.resource.data.uid == request.auth.uid)
          ||
          (request.resource.data.isBot == true
            && request.auth.uid in get(/databases/$(database)/documents/games/$(gameId)).data.players)
        );
      }

      // Create: must be the white player.
      // Human games start in 'waiting' with no black player yet.
      // Bot games start in 'active' immediately (bot uid begins with "bot_").
      allow create: if request.auth != null
        && request.resource.data.whiteUid == request.auth.uid
        && (
          (request.resource.data.status   == 'waiting'
            && request.resource.data.blackUid == null)
          ||
          (request.resource.data.status   == 'active'
            && request.resource.data.blackUid is string
            && request.resource.data.blackUid.matches('bot_.*'))
        );

      allow update: if request.auth != null && (

        // Joining as black: game is waiting, slot is open, joiner sets themselves
        (resource.data.status   == 'waiting'
          && resource.data.blackUid == null
          && request.resource.data.blackUid == request.auth.uid
          && request.resource.data.status   == 'active') ||

        // Making a move: game is active, one new move appended, correct player's turn
        (resource.data.status == 'active'
          && request.resource.data.moves.size() == resource.data.moves.size() + 1
          && (
            (resource.data.moves.size() % 2 == 0 && resource.data.whiteUid == request.auth.uid) ||
            (resource.data.moves.size() % 2 == 1 && resource.data.blackUid == request.auth.uid)
          )) ||

        // Finishing the game: must be a participant
        (resource.data.status == 'active'
          && request.resource.data.status == 'finished'
          && request.auth.uid in resource.data.players)
      );
    }
  }
}
